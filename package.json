{
  "name": "picagent-suite-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsx server/index.ts",
    "import-prompts": "tsx server/import-prompts.ts",
    "seed:validation-rag": "tsx server/seed-validation-rag.ts",
    "seed:demo": "tsx server/seed-demo.ts",
    "test:ticket05": "tsx --test tests/ticket05.contract.test.ts tests/ticket05.input.test.ts",
    "test:ticket02": "tsx --test tests/suite-input-images.contract.test.ts tests/multipart-encoding.test.ts",
    "test:pg": "PG_CONTRACT_TEST=1 PLATFORM_MIGRATION_TEST=1 tsx --env-file-if-exists=.env --test tests/pg-migrations.contract.test.ts tests/suite-platform-background.contract.test.ts",
    "start": "node dist-server/server/index.js",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build": "tsc -p tsconfig.app.json && vite build && npm run build:server",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.206.0",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@xyflow/react": "^12.11.3",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.5.0",
    "konva": "^10.3.2",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.3",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
